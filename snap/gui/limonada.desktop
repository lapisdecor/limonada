[Desktop Entry]
Type=Application
Version=1.0
Name=Limonada
GenericName=Lemmy client
Comment=Browse, search, vote and comment on Lemmy
# Snapcraft copies this file into meta/gui untouched, but snapd does not: it
# exports a sanitised copy to /var/lib/snapd/desktop/applications and drops any
# `Icon=` path that is not under ${SNAP} ("icon path ... is not part of the
# snap"). An absolute /snap/limonada/current/... path is exactly that, and it
# left the installed snap with no launcher icon at all. ${SNAP} is expanded at
# install time; the icon itself lands at meta/gui/icon.png from the manifest's
# `icon:` key. StartupWMClass is the app id the binary sets, as in the other
# three packages.
Exec=limonada
Icon=${SNAP}/meta/gui/icon.png
Terminal=false
Categories=Network;News;
StartupWMClass=com.gatochalupa.limonada
Keywords=lemmy;feddit;fediverse;link aggregator;activitypub;
